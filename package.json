{
  "name": "lp-gen",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "gen": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node src/pages.test.ts && node src/checks/checks.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@hono/node-server": "^2.1.5",
    "codemirror": "^6.0.2",
    "hono": "^4.13.14",
    "linkedom": "^0.18.14",
    "openai": "^7.45.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
