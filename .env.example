# Copy to .env and fill in. .env is git-ignored; real environment variables take precedence.

# Required: OpenAI API key used by every pipeline stage (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: port of the local API server (default 8790). The Vite dev server proxies /api and /out to it.
# API_PORT=8790
